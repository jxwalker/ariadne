{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ariadne:activity-event:2",
  "title": "Ariadne producer event v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "sourceId",
    "agent",
    "project",
    "repository",
    "taskId",
    "runId",
    "sequence",
    "occurredAt",
    "kind",
    "label",
    "summary"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "maxLength": 128
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "maxLength": 128
    },
    "project": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "maxLength": 128
    },
    "taskId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "maxLength": 128
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "maxLength": 128
    },
    "parentRunId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "maxLength": 128
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "maxLength": 128
    },
    "schemaVersion": {
      "const": 2,
      "type": "integer"
    },
    "kind": {
      "enum": [
        "heartbeat",
        "session.end",
        "session.start",
        "subagent.end",
        "subagent.start",
        "task.blocked",
        "task.completed",
        "task.failed",
        "task.interrupted",
        "task.progress",
        "task.resumed",
        "task.start",
        "decision.requested",
        "decision.resolved"
      ]
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "product",
        "version"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "product": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "summary": {
      "type": "string",
      "maxLength": 500
    },
    "location": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "machine",
            "cloud"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 250
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{40}$"
    },
    "pr": {
      "type": "integer",
      "minimum": 1
    },
    "evidenceLinks": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://",
        "maxLength": 2048
      }
    },
    "stage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "nextStep": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "blockerCategory": {
      "enum": [
        "decision",
        "ci",
        "review",
        "dependency",
        "access",
        "network",
        "capacity",
        "telemetry",
        "other"
      ]
    },
    "classification": {
      "enum": [
        "work",
        "test"
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "recipient"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "maxLength": 128
        },
        "recipient": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "resolution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "recommendation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "blocking": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https://"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "decision.requested"
          }
        }
      },
      "then": {
        "required": [
          "decision"
        ],
        "properties": {
          "decision": {
            "required": [
              "question",
              "blocking"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "decision.resolved"
          }
        }
      },
      "then": {
        "required": [
          "decision"
        ],
        "properties": {
          "decision": {
            "required": [
              "resolution"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "not": {
              "enum": [
                "decision.requested",
                "decision.resolved"
              ]
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "decision"
          ]
        }
      }
    }
  ]
}
