# TEMPLATE ONLY. Requires approved domain/provider and valid certificate before use.
# Upstream must run activity_server.py with ingestOnly=true at loopback 18096.
# Never proxy the private dashboard listener 18095 publicly.
server {
    listen 443 ssl;
    server_name APPROVED_INGESTION_DOMAIN;
    ssl_certificate /APPROVED_CERTIFICATE_PATH;
    ssl_certificate_key /PROTECTED_KEY_PATH;
    client_max_body_size 64k;
    client_body_timeout 5s;
    # Keep observations at the existing 64k limit.
    location = /ingest/v1/events {
        limit_except POST { deny all; }
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
        proxy_pass http://127.0.0.1:18096;
    }
    # PROPOSAL ONLY: backend route-specific body limit must be reviewed first.
    # Observed 80-159KB requests exceed 64k; 2m provides headroom without accepting 25MB.
    location = /ingest/v1/github {
        client_max_body_size 2m;
        limit_except POST { deny all; }
        proxy_connect_timeout 2s;
        # Diagnostic headroom only: backend must durably ack within GitHub's 10s budget.
        proxy_read_timeout 35s;
        proxy_pass http://127.0.0.1:18096;
    }
    location / { return 404; }
}
